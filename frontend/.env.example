SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
ADMIN_PASSWORD="your-admin-password"

# Razorpay Payment Gateway (Paste keys in .env.local locally & in Vercel Environment Variables)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_secret_..."

# Google OAuth (Domain-restricted campus login)(Paste keys in .env.local locally & in Vercel Environment Variables)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
ALLOWED_EMAIL_DOMAIN="rishihood.edu.in"
ADMIN_EMAILS="admin@rishihood.edu.in"
